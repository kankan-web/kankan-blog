---
import { sideMenus } from "@constant";
import { Image } from "astro:assets";

const isCurrentPage = (url: string) => {
  const pathname = Astro.url.pathname;
  console.log("pathname", pathname);
  if (url === pathname) return true;
  if (pathname.includes(url) && url !== "/") return true;
  return false;
};
---

<nav class="flex flex-col gap-1">
  {
    sideMenus.map((menu) => (
      <a
        href={menu.url}
        class="group flex items-center rounded-lg p-2"
        class:list={[
          {
            "bg-black text-white": isCurrentPage(menu.url),
            "hover:bg-gray-200": !isCurrentPage(menu.url),
          },
        ]}
      >
        <span class="h-4 w-4">
          <Image
            class:list={[
              "aspect-square h-full w-full",
              {
                // 当前页面时，反色图标，让描边变为白色
                invert: isCurrentPage(menu.url),
              },
            ]}
            width={10}
            height={10}
            src={menu.icon}
            alt={`menu icon ${menu.name}`}
          />
        </span>
        <span class="ml-2 font-medium"> {menu.name}</span>
      </a>
    ))
  }
</nav>
