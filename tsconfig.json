{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths":{
      "@component/*":["./src/components/*"],
      "@assets/*":["./src/assets/*"],
      "@layouts/*":["./src/layouts/*"],
    }
  }
}